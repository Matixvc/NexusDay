{
  "expo": {
    "name": "NexusDay",
    "slug": "nexusday",
    "scheme": "nexusday",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.matix03.nexusday",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "NexusDay usa el micrófono solo para grabar las notas de voz que se guardan en este dispositivo.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NexusDay usa Face ID para abrir las notas y los gastos que marcaste como privados."
        }
      ]
    ],
    "owner": "matix03",
    "extra": {
      "eas": {
        "projectId": "087f40a1-254c-4153-b120-9e77392b5cd0"
      }
    }
  }
}
